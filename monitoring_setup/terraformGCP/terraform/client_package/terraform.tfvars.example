# ============================================================================
# Terraform Variables - Update with YOUR values
# ============================================================================
# Copy this file to terraform.tfvars and update the values below
# ============================================================================

# TODO: Replace with YOUR GCP Project ID
gcp_project_id = "YOUR-GCP-PROJECT-ID"

# AWS Lambda URL (pre-configured, can be overridden if needed)
aws_lambda_url = "https://SHARED-LAMBDA-URL.lambda-url.us-east-1.on.aws"

# TODO: Replace with YOUR Reasoning Engine IDs
reasoning_engine_ids = [
  "YOUR-ENGINE-ID"  # Get from: gcloud ai reasoning-engines list
]

# ============================================================================
# What to update:
#   1. gcp_project_id - Your GCP Project ID
#   2. reasoning_engine_ids - Your Reasoning Engine IDs
#
# Then run:
#   terraform init
#   terraform apply
# ============================================================================
